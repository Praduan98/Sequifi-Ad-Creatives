  "components": [
    {
      "name": "Pill, on",
      "kind": "chip",
      "refersTo": "pill-on",
      "description": "Active choice pill pressed by the cursor.",
      "html": "<div class=\"ds-pill-on\">Automated</div>",
      "css": ".ds-pill-on{display:inline-flex;align-items:center;gap:14px;height:92px;padding:0 38px 0 28px;border-radius:46px;font:600 48px/1 'DM Sans',sans-serif;letter-spacing:-0.015em;color:#fff;background:linear-gradient(180deg,#8597F6,#5A70E6);box-shadow:0 16px 40px -12px rgba(96,120,236,.85),inset 0 1.5px 0 rgba(255,255,255,.45),inset 0 0 0 1px rgba(255,255,255,.14);transition:transform .2s cubic-bezier(.34,1.56,.64,1)}.ds-pill-on:hover{transform:scale(1.03)}.ds-pill-on:active{transform:scale(.97)}"
    },
    {
      "name": "Pill, ghost",
      "kind": "chip",
      "refersTo": "pill-ghost",
      "description": "An unchosen option beside an active pill.",
      "html": "<div class=\"ds-pill-ghost\">Manual</div>",
      "css": ".ds-pill-ghost{display:inline-flex;align-items:center;height:92px;padding:0 38px 0 28px;border-radius:46px;font:600 48px/1 'DM Sans',sans-serif;letter-spacing:-0.015em;background:rgba(143,160,245,.08);color:rgba(185,196,255,.42);box-shadow:inset 0 0 0 1.5px rgba(143,160,245,.24);transition:color .2s,box-shadow .2s}.ds-pill-ghost:hover{color:rgba(185,196,255,.8);box-shadow:inset 0 0 0 1.5px rgba(143,160,245,.5)}"
    },
    {
      "name": "End-card CTA",
      "kind": "button",
      "refersTo": "cta",
      "description": "The film's closing call to action.",
      "html": "<button class=\"ds-cta\">Watch the film</button>",
      "css": ".ds-cta{display:inline-flex;align-items:center;justify-content:center;gap:16px;height:100px;padding:0 52px;border:0;border-radius:50px;font:700 40px/1 'DM Sans',sans-serif;letter-spacing:-0.015em;color:#fff;background:linear-gradient(180deg,#8597F6,#5A70E6);box-shadow:0 24px 50px -18px rgba(76,96,230,.75),inset 0 2px 0 rgba(255,255,255,.4),inset 0 0 0 1px rgba(255,255,255,.12);cursor:pointer;transition:transform .2s}.ds-cta:hover{transform:translateY(-2px)}.ds-cta:focus-visible{outline:3px solid #B9C4FF;outline-offset:4px}.ds-cta:active{transform:scale(.97)}"
    },
    {
      "name": "Selection box",
      "kind": "custom",
      "description": "The editor's selection round the one bold word: hairline edges and four square handles.",
      "html": "<div class=\"ds-selstage\">in <span class=\"ds-sel\">code.<i class=\"tl\"></i><i class=\"tr\"></i><i class=\"bl\"></i><i class=\"br\"></i></span></div>",
      "css": ".ds-selstage{background:#070B22;padding:40px;font:400 96px/1 'DM Sans',sans-serif;letter-spacing:-0.035em;color:#EEF1FF}.ds-sel{position:relative;display:inline-block;padding:0 14px 4px 10px;border:2px solid #B9C4FF;font-weight:700;color:#fff}.ds-sel i{position:absolute;width:14px;height:14px;background:#070B22;border:2px solid #B9C4FF;border-radius:2px}.ds-sel .tl{left:-9px;top:-9px}.ds-sel .tr{right:-9px;top:-9px}.ds-sel .bl{left:-9px;bottom:-9px}.ds-sel .br{right:-9px;bottom:-9px}"
    },
    {
      "name": "Cursor",
      "kind": "custom",
      "description": "Pointer arrow: cream with an ink outline on dark, inverted on ice.",
      "html": "<div class=\"ds-cur\"><svg viewBox=\"0 0 24 24\" width=\"46\" height=\"46\"><path d=\"M4.2 2.4v17.9l4.6-4.3 3.1 6.9 3.2-1.4-3-6.8h6.5z\"/></svg><svg class=\"lt\" viewBox=\"0 0 24 24\" width=\"46\" height=\"46\"><path d=\"M4.2 2.4v17.9l4.6-4.3 3.1 6.9 3.2-1.4-3-6.8h6.5z\"/></svg></div>",
      "css": ".ds-cur{display:flex;justify-content:space-around;padding:24px 40px;background:linear-gradient(90deg,#050817 50%,#F5F7FF 50%)}.ds-cur svg{filter:drop-shadow(0 6px 10px rgba(0,0,0,.35));transition:transform .15s}.ds-cur svg:hover{transform:scale(.84)}.ds-cur path{fill:#F2F4FF;stroke:#0D1020;stroke-width:1.3;stroke-linejoin:round}.ds-cur .lt path{fill:#0D1020;stroke:#fff}"
    },
    {
      "name": "Dark UI card",
      "kind": "card",
      "refersTo": "card",
      "description": "Floating product-UI card inside the film.",
      "html": "<div class=\"ds-card\"><div class=\"ttl\">Pay mix</div><div class=\"big\">72%</div><div class=\"row\"><span>Base</span><span class=\"v\">+4,200</span></div></div>",
      "css": ".ds-card{position:relative;width:400px;padding:28px;border-radius:28px;color:#E9ECFF;font-family:Inter,sans-serif;background:linear-gradient(180deg,rgba(30,39,88,.96),rgba(15,20,50,.96));box-shadow:inset 0 0 0 1px rgba(143,160,245,.18),0 40px 70px -34px rgba(0,0,0,.85)}.ds-card .ttl{font:600 21px/1 Inter,sans-serif;color:rgba(233,236,255,.66)}.ds-card .big{margin:24px 0;font:700 44px/1 Inter,sans-serif;letter-spacing:-0.03em}.ds-card .row{display:flex;justify-content:space-between;font:500 19px/1 Inter,sans-serif;color:rgba(233,236,255,.9)}.ds-card .v{font-weight:600;color:#8FE8C8;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Chip and toggle",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Status chip and the mint on-toggle inside cards.",
      "html": "<div class=\"ds-ct\"><span class=\"ds-chip\">Paid</span><span class=\"ds-tg on\"></span><span class=\"ds-tg\"></span></div>",
      "css": ".ds-ct{display:flex;gap:20px;align-items:center;padding:24px;background:#0F1432}.ds-chip{display:inline-flex;align-items:center;height:38px;padding:0 16px;border-radius:19px;font:600 17px/1 Inter,sans-serif;background:rgba(43,181,148,.22);color:#8FE8C8}.ds-tg{position:relative;width:52px;height:30px;border-radius:15px;background:rgba(143,160,245,.25)}.ds-tg::after{content:'';position:absolute;left:3px;top:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:left .25s cubic-bezier(.34,1.56,.64,1)}.ds-tg.on{background:#2BB594}.ds-tg.on::after{left:25px}"
    },
