    "motion": [
      {
        "name": "spring",
        "value": "1 - e^(-d*w0*t) * (cos(wd*t) + (d*w0/wd) * sin(wd*t)), w0 = 2pi/response",
        "purpose": "iOS-style overshooting spring for every pop; word pops use response 0.42, damping 0.55."
      },
      {
        "name": "edge-draw",
        "value": "0.09s per edge, stagger 0.07s, inOutCubic",
        "purpose": "Selection-box edges drawing on in turn."
      },
      {
        "name": "handle-pop",
        "value": "spring response 0.3, damping 0.5, stagger 0.03s",
        "purpose": "Selection-box handles after the edges."
      },
      {
        "name": "hop",
        "value": "x,y eased inOutSine; y -= h*4u(1-u)",
        "purpose": "Parabolic hops of the hero."
      },
      {
        "name": "landing-squash",
        "value": "k * e^(-8t) * cos(26t), k ~ 0.3",
        "purpose": "Damped squash on landing; stretch along velocity up to 20%."
      },
      {
        "name": "type-on",
        "value": "0.032s per character",
        "purpose": "Typed words; a typed word never starts before the previous one finishes."
      },
      {
        "name": "highlight-grow",
        "value": "0.26s outCubic, scaleX from the left",
        "purpose": "Highlight bar behind a word."
      },
      {
        "name": "wipe",
        "value": "circular, 0 to 2300px radius, 30px soft edge, inOutCubic",
